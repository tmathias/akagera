# ============================================================
#  Akagera Aviation EFB — Environment Variables Template
#  Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/akagera_efb?schema=public"

# --- Redis (session cache, rate-limit, tile cache) ----------------------
REDIS_URL="redis://localhost:6379"

# --- Auth (Clerk.dev) ---------------------------------------------------
# Create app at https://dashboard.clerk.com
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# --- AWS S3 (document storage) ------------------------------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="akagera-documents"

# --- Cesium Ion (3D terrain + satellite imagery) ------------------------
# Free tier at https://ion.cesium.com
VITE_CESIUM_ION_TOKEN="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- Meteoblue (weather forecast + imagery) -----------------------------
# https://www.meteoblue.com/en/weather-api
METEOBLUE_API_KEY=""

# --- Windy API (animated weather overlays) ------------------------------
# https://api.windy.com
WINDY_API_KEY=""

# --- OpenSky Network (ADS-B traffic, free) ------------------------------
# Optional credentials for higher rate limits
OPENSKY_USERNAME=""
OPENSKY_PASSWORD=""

# --- Flightradar24 (premium traffic fallback) ---------------------------
FLIGHTRADAR24_API_KEY=""

# --- App config ---------------------------------------------------------
NODE_ENV="development"
API_PORT=3001
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="change-me-in-production-use-long-random-string"
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# --- Frontend -----------------------------------------------------------
VITE_API_URL="http://localhost:3001"
VITE_WS_URL="ws://localhost:3001"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
